# Neon Postgres connection string (created via Vercel's Storage tab, which
# provisions a Neon database and injects this automatically once linked).
# Use the pooled connection string (hostname contains "-pooler"), since this
# app runs on Vercel serverless functions.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-value"

# Checked by /api/cron/* routes against the Authorization header Vercel Cron
# sends automatically. Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-value"
